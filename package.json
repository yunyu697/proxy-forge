{
  "name": "proxy-forge",
  "private": true,
  "version": "1.2.6",
  "type": "module",
  "description": "代理工坊 - mihomo / sing-box 配置生成器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "vitest run",
    "sync-version": "node scripts/sync-version.mjs",
    "preversion": "npm run lint && npm run typecheck && npm test",
    "version": "npm run sync-version && git add -A",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src scripts",
    "format": "prettier --write src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.45",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.3",
    "vitest": "^2.1.9"
  }
}
